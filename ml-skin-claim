import React, { useState } from 'react'; import { Button } from '@/components/ui/button'; import { Card, CardContent } from '@/components/ui/card'; import { Input } from '@/components/ui/input';

const LoginPage = ({ onLogin }) => { const [email, setEmail] = useState('');

const handleLogin = () => { if (email) onLogin(email); };

return ( <div className="flex flex-col items-center justify-center min-h-screen bg-blue-50 p-4"> <Card className="w-full max-w-md text-center"> <CardContent className="p-6"> <h1 className="text-2xl font-bold mb-4">Login untuk Klaim Skin ML</h1> <Button className="w-full mb-3" onClick={() => onLogin('fb_user')}>Login dengan Facebook</Button> <div className="my-2 text-gray-500">atau</div> <Input type="email" placeholder="Masukkan Email" value={email} onChange={(e) => setEmail(e.target.value)} className="mb-3" /> <Button className="w-full" onClick={handleLogin}>Login dengan Email</Button> </CardContent> </Card> </div> ); };

const ClaimPage = ({ user }) => { const [claimed, setClaimed] = useState(false);

return ( <div className="flex flex-col items-center justify-center min-h-screen bg-green-50 p-4"> <Card className="w-full max-w-md text-center"> <CardContent className="p-6"> <h1 className="text-2xl font-bold mb-4">Selamat Datang, {user}</h1> <p className="mb-4">Klik tombol di bawah untuk klaim hadiah skin Mobile Legends Anda.</p> <Button onClick={() => setClaimed(true)} disabled={claimed}> {claimed ? 'Skin Sudah Diklaim!' : 'Klaim Skin Sekarang'} </Button> </CardContent> </Card> </div> ); };

export default function App() { const [user, setUser] = useState(null);

return user ? <ClaimPage user={user} /> : <LoginPage onLogin={setUser} />; }

